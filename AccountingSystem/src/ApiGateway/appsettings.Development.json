  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://localhost:3000",
      "https://localhost:5173",
      "http://localhost:8080",
      "http://localhost:8081"
    ],
    "AllowCredentials": true
  },
  "ServiceDiscovery": {
    "Services": {
      "identity-service": "http://localhost:5001",
      "customer-service": "http://localhost:5002",
      "product-service": "http://localhost:5003",
      "invoice-service": "http://localhost:5004",
      "payment-service": "http://localhost:5005",
      "gl-service": "http://localhost:5006",
      "ar-service": "http://localhost:5007",
