      "document-service": "http://localhost:5010"
    }
  },
  "RateLimiting": {
    "Global": {
      "Window": "00:01:00",
      "PermitLimit": 1000
    },
    "Authentication": {
      "Window": "00:01:00",
      "PermitLimit": 50
    },
    "Api": {
      "Window": "01:00:00",
      "PermitLimit": 5000
    },
    "Reporting": {
      "PermitLimit": 10
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "apiKey": null
        }
      }
    ]
  },
  "OpenTelemetry": {
    "Tracing": {
      "SamplingRatio": 1.0
    }
  }
