  "CorsSettings": {
    "AllowedOrigins": [
      "https://your-production-domain.com",
      "https://www.your-production-domain.com"
    ],
    "AllowCredentials": true
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": ["accounting-api"],
        "ValidIssuer": "https://identity.your-production-domain.com",
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "IssuerSigningKey": "your-production-secret-key-here"
      }
    }
  },
  "ServiceDiscovery": {
    "Services": {
      "identity-service": "http://identity-service",
      "customer-service": "http://customer-service",
      "product-service": "http://product-service",
      "invoice-service": "http://invoice-service",
      "payment-service": "http://payment-service",
      "gl-service": "http://gl-service",
      "ar-service": "http://ar-service",
      "ap-service": "http://ap-service",
      "reporting-service": "http://reporting-service",
      "document-service": "http://document-service"
    }
  },
  "HealthChecks": {
    "SqlServer": {
      "ConnectionString": "Server=sqlserver;Database=AccountingSystem;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;"
    },
    "RabbitMQ": {
      "ConnectionString": "amqp://guest:guest@rabbitmq:5672/"
    },
    "Redis": {
      "ConnectionString": "redis:6379"
    }
  },
  "RateLimiting": {
    "Global": {
      "Window": "00:01:00",
      "PermitLimit": 100
    },
    "Authentication": {
      "Window": "00:01:00",
      "PermitLimit": 20
    },
    "Api": {
      "Window": "01:00:00",
      "PermitLimit": 1000
    },
    "Reporting": {
      "PermitLimit": 5
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ]
  },
  "OpenTelemetry": {
    "Jaeger": {
      "Endpoint": "http://jaeger:14268/api/traces"
    },
    "Tracing": {
      "SamplingRatio": 0.1
    }
  }
}